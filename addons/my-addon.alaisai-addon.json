  "files": [
    {
      "name": "manifest.json",
      "content": "{\n  \"id\": \"my-addon\",\n  \"name\": \"my-addon\",\n  \"icon\": \"🪐\",\n  \"version\": \"1.0.0\",\n  \"description\": \"إضافة جديدة\",\n  \"author\": \"\"\n}"
    },
    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>المتصفح السريع - بوابة المطورين</title>\n<style>\n  :root {\n    --bg-grad-start: #1a1a2e;\n    --bg-grad-end: #16213e;\n    --gold: #4cc9f0;\n    --text-main: #ffffff;\n    --text-muted: #94a3b8;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }\n  \n  body { \n    background-color: #0f0f1a; \n    color: var(--text-main); \n    display: flex; justify-content: center; min-height: 100vh; padding: 10px;\n  }\n\n  #app-container {\n    width: 100%; max-width: 650px; \n    background: linear-gradient(145deg, var(--bg-grad-start), var(--bg-grad-end)); \n    border-radius: 25px; padding: 20px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n    position: relative; height: fit-content; min-height: 90vh;\n  }\n\n  /* === رأس التطبيق === */\n  .app-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }\n  .header-icon {\n    width: 45px; height: 45px; border-radius: 15px;\n    background: linear-gradient(135deg, var(--gold), #f72585);\n    display: flex; align-items: center; justify-content: center;\n  }\n  .header-icon svg { width: 26px; height: 26px; fill: white; }\n  .header-text h1 { font-size: 1.2rem; margin: 0; color: white; }\n  .header-text p { margin: 2px 0 0; color: var(--text-muted); font-size: 0.75rem; }\n  \n  /* زر إعدادات الأقسام */\n  .btn-settings {\n    margin-right: auto;\n    background: rgba(255,255,255,0.1);\n    border: 1px solid var(--gold);\n    color: var(--gold);\n    width: 40px; height: 40px;\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    cursor: pointer; font-size: 1.2rem; transition: 0.2s;\n  }\n  .btn-settings:hover { background: var(--gold); color: #000; transform: rotate(45deg); }\n\n  /* === شريط البحث === */\n  .search-box {\n    width: 100%; padding: 12px 15px;\n    background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 10px; color: white; font-size: 0.95rem;\n    margin-bottom: 20px; outline: none; transition: 0.3s;\n  }\n  .search-box:focus { border-color: var(--gold); box-shadow: 0 0 10px rgba(76, 201, 240, 0.2); }\n\n  /* === العناوين والأقسام === */\n  .section-header {\n    display: flex; justify-content: space-between; align-items: center;\n    margin: 15px 0 8px 0; padding-bottom: 5px;\n    border-bottom: 1px solid rgba(255,255,255,0.1);\n  }\n  .section-title {\n    font-size: 0.95rem; color: var(--gold);\n    display: flex; align-items: center; gap: 6px; font-weight: 600;\n  }\n  .section-title::before {\n    content: ''; display: block; width: 4px; height: 14px; background: var(--gold); border-radius: 2px;\n  }\n  .menu-btn {\n    background: transparent; border: none; color: var(--text-muted);\n    font-size: 1.4rem; cursor: pointer; padding: 0 5px; transition: 0.2s; line-height: 1;\n  }\n  .menu-btn:hover { color: white; transform: scale(1.1); }\n\n  /* === شبكة التطبيقات === */\n  .site-grid { \n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 10px; \n  }\n\n  /* === بطاقة التطبيق === */\n  .site-btn { \n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n    gap: 6px; padding: 10px 4px; border-radius: 10px;\n    text-decoration: none; text-align: center;\n    transition: transform 0.2s, filter 0.2s; \n    border: 1px solid rgba(255,255,255,0.1);\n    position: relative; overflow: hidden;\n  }\n  .site-btn:hover { transform: translateY(-2px); filter: brightness(1.15); box-shadow: 0 4px 10px rgba(0,0,0,0.3); }\n  \n  .site-btn svg, .site-btn img { width: 24px; height: 24px; object-fit: contain; fill: currentColor; flex-shrink: 0; border-radius: 4px; }\n  \n  .site-names { display: flex; flex-direction: column; line-height: 1.2; width: 100%; }\n  .site-name-en { font-size: 0.8rem; font-weight: 700; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .site-name-ar { font-size: 0.65rem; opacity: 0.9; font-weight: 500; }\n\n  /* === التنبيه المحلي === */\n  .warning-box {\n    background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3);\n    color: #fde047; padding: 8px 12px; border-radius: 8px;\n    font-size: 0.7rem; margin-top: 10px; text-align: center; line-height: 1.4;\n  }\n\n  /* === الشريط السفلي === */\n  .footer-bar {\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(0,0,0,0.3); border-radius: 8px; padding: 10px 12px;\n    font-size: 0.75rem; margin-top: 20px; color: var(--text-muted);\n  }\n  .footer-bar strong { color: var(--gold); }\n\n  /* === النوافذ المنبثقة (Modal) === */\n  .modal-overlay {\n    position: fixed; inset: 0; background: rgba(0,0,0,0.85);\n    display: flex; justify-content: center; align-items: center;\n    z-index: 1000; opacity: 0; visibility: hidden; transition: 0.3s;\n  }\n  .modal-overlay.active { opacity: 1; visibility: visible; }\n  \n  .modal-content {\n    background: #1e1e2f; border: 1px solid var(--gold); border-radius: 15px;\n    width: 90%; max-width: 400px; padding: 20px; max-height: 85vh;\n    display: flex; flex-direction: column;\n  }\n  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }\n  .modal-title { font-size: 1.1rem; color: var(--gold); font-weight: bold; }\n  .modal-close { background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer; }\n  \n  /* إدارة القوائم */\n  .manage-list { overflow-y: auto; margin-bottom: 15px; padding-left: 5px; flex: 1; }\n  .manage-item {\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(255,255,255,0.05); padding: 8px 10px; border-radius: 8px;\n    margin-bottom: 8px;\n  }\n  .manage-item-info { display: flex; flex-direction: column; }\n  .manage-item-name { font-size: 0.85rem; font-weight: bold; }\n  .manage-item-name span { font-size: 0.7rem; color: var(--text-muted); font-weight: normal; }\n  .manage-actions { display: flex; gap: 4px; }\n  \n  .btn-icon { background: rgba(255,255,255,0.1); border: none; color: white; padding: 4px 6px; border-radius: 5px; cursor: pointer; font-size: 0.8rem; transition: 0.2s; }\n  .btn-icon:hover { background: var(--gold); color: #000; }\n  .btn-icon:disabled { opacity: 0.3; cursor: not-allowed; }\n  .btn-icon.edit:hover { background: #4cc9f0; color: #000; }\n  .btn-icon.danger { color: #ff6b6b; }\n  .btn-icon.danger:hover { background: #ff6b6b; color: #fff; }\n\n  /* أزرار النافذة */\n  .modal-actions { display: flex; flex-direction: column; gap: 8px; }\n  .btn-primary {\n    background: var(--gold); color: #000; border: none; padding: 10px;\n    border-radius: 8px; font-weight: bold; cursor: pointer; text-align: center;\n  }\n  .btn-secondary {\n    background: rgba(255,255,255,0.1); color: white; border: none; padding: 10px;\n    border-radius: 8px; font-weight: bold; cursor: pointer; text-align: center;\n  }\n  .btn-success {\n    background: linear-gradient(135deg, #10b981, #059669);\n    color: white; border: none; padding: 10px;\n    border-radius: 8px; font-weight: bold; cursor: pointer; text-align: center;\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    margin-top: 5px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);\n  }\n  .btn-success:hover { filter: brightness(1.1); }\n\n  /* حقول الإدخال */\n  .input-group { margin-bottom: 10px; }\n  .input-group label { display: block; font-size: 0.8rem; margin-bottom: 4px; color: var(--text-muted); }\n  .input-group input { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.3); color: white; outline: none; }\n  .input-group input:focus { border-color: var(--gold); }\n  .input-group input[type=\"file\"] { font-size: 0.8rem; padding: 5px; }\n  .opt-text { font-size: 0.7rem; color: #64748b; margin-right: 5px; }\n\n  @media (max-width: 400px) {\n    .site-name-en { font-size: 0.7rem; }\n    .site-name-ar { font-size: 0.6rem; }\n    .site-btn svg, .site-btn img { width: 20px; height: 20px; }\n  }\n</style>\n</head>\n<body>\n\n<div id=\"app-container\">\n  \n  <div class=\"app-header\">\n    <div class=\"header-icon\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/></svg>\n    </div>\n    <div class=\"header-text\">\n      <h1>المتصفح السريع</h1>\n      <p>بوابة أدوات المطورين والمصممين</p>\n    </div>\n    <button class=\"btn-settings\" onclick=\"openCategoryManageModal()\" title=\"إدارة الأقسام\">\n      ⚙️\n    </button>\n  </div>\n\n  <input type=\"text\" id=\"searchInput\" class=\"search-box\" placeholder=\"🔍 ابحث عن أداة أو موقع...\">\n\n  <div id=\"sitesContainer\"></div>\n\n  <div class=\"footer-bar\">\n    <span>⚡ سرعة فائقة</span>\n    <span>● <strong id=\"siteCount\">0</strong> موقعاً</span>\n    <span>📁 <strong id=\"catCount\">0</strong> أقسام</span>\n  </div>\n\n</div>\n\n<!-- ========================================== -->\n<!-- نافذة إدارة الأقسام (جديدة) -->\n<!-- ========================================== -->\n<div class=\"modal-overlay\" id=\"categoryManageModal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\">إدارة الأقسام</div>\n      <button class=\"modal-close\" onclick=\"closeModal('categoryManageModal')\">✖</button>\n    </div>\n    \n    <div class=\"manage-list\" id=\"categoryManageList\"></div>\n    \n    <div class=\"modal-actions\">\n      <button class=\"btn-primary\" onclick=\"addNewCategory()\">➕ إضافة قسم جديد</button>\n    </div>\n  </div>\n</div>\n\n<!-- نافذة إدارة الاختصارات داخل القسم -->\n<div class=\"modal-overlay\" id=\"manageModal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\" id=\"manageModalTitle\">إدارة القسم</div>\n      <button class=\"modal-close\" onclick=\"closeModal('manageModal')\">✖</button>\n    </div>\n    \n    <div class=\"manage-list\" id=\"manageList\"></div>\n    \n    <div class=\"modal-actions\">\n      <button class=\"btn-primary\" onclick=\"openAddModal()\">➕ إضافة اختصار جديد</button>\n      <button class=\"btn-success\" onclick=\"exportCode()\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\"><path d=\"M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z\"/></svg>\n        حفظ / مشاركة الكود\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- نافذة إضافة / تعديل اختصار -->\n<div class=\"modal-overlay\" id=\"addModal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\" id=\"addModalTitle\">إضافة اختصار</div>\n      <button class=\"modal-close\" onclick=\"closeModal('addModal')\">✖</button>\n    </div>\n    <div class=\"input-group\">\n      <label>الرابط (إجباري)</label>\n      <input type=\"url\" id=\"newUrl\" placeholder=\"https://example.com\" dir=\"ltr\">\n    </div>\n    <div class=\"input-group\">\n      <label>الاسم بالإنجليزية <span class=\"opt-text\">(اختياري)</span></label>\n      <input type=\"text\" id=\"newNameEn\" placeholder=\"مثال: YouTube\" dir=\"ltr\">\n    </div>\n    <div class=\"input-group\">\n      <label>الاسم بالعربية <span class=\"opt-text\">(اختياري)</span></label>\n      <input type=\"text\" id=\"newNameAr\" placeholder=\"مثال: يوتيوب\">\n    </div>\n    <div class=\"input-group\">\n      <label>لون الخلفية <span class=\"opt-text\">(اختياري)</span></label>\n      <input type=\"color\" id=\"newColor\" value=\"#4cc9f0\" style=\"height: 40px; padding: 2px;\">\n    </div>\n    <div class=\"input-group\">\n      <label>رفع أيقونة مخصصة <span class=\"opt-text\">(اختياري - يجلب الشعار تلقائياً إذا تُرك فارغاً)</span></label>\n      <input type=\"file\" id=\"newIconFile\" accept=\"image/*\">\n    </div>\n    <button class=\"btn-primary\" id=\"btnSaveShortcut\" style=\"margin-top: 10px;\">حفظ الاختصار</button>\n  </div>\n</div>\n\n<script>\n// ==========================================\n// 1. البيانات الافتراضية\n// ==========================================\nconst defaultData = [\n  {\n    id: \"ai\",\n    category: \"الذكاء الاصطناعي\",\n    sites: [\n      { nameEn: \"ChatGPT\", nameAr: \"شات جي بي تي\", url: \"https://chatgpt.com/\", color: \"#10a37f\", icon: `<svg viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M22.281 11.51c0-1.108-.34-2.15-.92-3.01.23-1.02.06-2.12-.49-3.02-.95-1.56-2.62-2.48-4.42-2.48-.3 0-.59.03-.88.08C14.84 2.16 13.47 1.5 12 1.5c-2.17 0-4.08 1.32-4.9 3.18-.16-.02-.32-.03-.48-.03-2.32 0-4.28 1.65-4.76 3.86C1.15 9.61.5 11.24.5 12.94c0 2.17 1.32 4.08 3.18 4.9-.02.16-.03.32-.03.48 0 2.32 1.65 4.28 3.86 4.76 1.1 1.71 2.73 2.36 4.43 2.36 1.108 0 2.15-.34 3.01-.92 1.02.23 2.12.06 3.02-.49 1.56-.95 2.48-2.62 2.48-4.42 0-.3-.03-.59-.08-.88 1.61-1.15 2.61-2.97 2.61-4.92zm-10.17 7.08c-1.36 0-2.49-.63-3.25-1.62l.78-2.14c.18.02.35.03.53.03 1.96 0 3.55-1.59 3.55-3.55 0-1.05-.46-2.02-1.21-2.67l1.5-1.5c1.36 1.2 2.21 2.95 2.21 4.9 0 3.59-2.91 6.5-6.5 6.5-.53 0-1.05-.06-1.55-.18l.93-2.54c.51.17 1.05.26 1.61.26zm-2.3-9.77c0-1.36.63-2.49 1.62-3.25l2.14.78c-.02.18-.03.35-.03.53 0 1.96 1.59 3.55 3.55 3.55 1.05 0 2.02-.46 2.67-1.21l1.5 1.5c-1.2 1.36-2.95 2.21-4.9 2.21-3.59 0-6.5-2.91-6.5-6.5 0-.53.06-1.05.18-1.55l2.54.93c-.17.51-.26 1.05-.26 1.61z\"/></svg>` },\n      { nameEn: \"Gemini\", nameAr: \"جيميني\", url: \"https://gemini.google.com/